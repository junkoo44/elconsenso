# Configuración de Firebase para el modo Online.
# Copiá este archivo a ".env" y completá con los valores de tu proyecto de Firebase
# (Configuración del proyecto > Tus apps > SDK setup and configuration).
#
# IMPORTANTE: creá la base de datos como "Realtime Database" (no Firestore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
